{
  "name": "layerstack-monorepo",
  "version": "0.0.1",
  "author": "Sean Lynch <techniq35@gmail.com>",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm clean && pnpm package && pnpm --parallel --filter './packages/*' --filter @layerstack/docs-site --if-present dev",
    "test:unit": "pnpm -r test:unit",
    "clean": "rimraf packages/*/dist",
    "build": "pnpm clean && pnpm -r build",
    "build:packages": "pnpm clean && pnpm --filter './packages/*' build",
    "package": "pnpm --filter './packages/*' package",
    "check": "pnpm -r check",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:release": "changeset publish",
    "up-deps": "pnpm update -r -i --latest"
  },
  "devDependencies": {
    "@changesets/cli": "2.29.4",
    "@svitejs/changesets-changelog-github-compact": "^1.2.0",
    "rimraf": "6.0.1",
    "wrangler": "^4.14.4"
  },
  "packageManager": "pnpm@9.6.0"
}

{
  "name": "@layerstack/ui",
  "description": "A collection of Svelte 5 components to build highly interactive applications",
  "author": "Sean Lynch <techniq35@gmail.com>",
  "license": "MIT",
  "repository": "techniq/layerstack",
  "version": "0.0.0",
  "scripts": {
    "dev": "trap 'exit 0' INT; svelte-package --watch",
    "clean": "rimraf dist",
    "build": "pnpm clean && svelte-package",
    "package": "svelte-package",
    "prepublishOnly": "svelte-package",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:unit": "vitest",
    "lint": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@shikijs/transformers": "^4.1.0",
    "@sveltejs/kit": "^2.21.0",
    "@sveltejs/package": "^2.3.11",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@types/d3-array": "^3.2.1",
    "@types/d3-scale": "^4.0.9",
    "@types/lodash-es": "^4.17.12",
    "@vitest/browser": "^4.1.8",
    "@vitest/browser-playwright": "^4.1.8",
    "playwright": "^1.60.0",
    "prettier": "^3.5.3",
    "prettier-plugin-svelte": "^3.5.2",
    "rimraf": "6.0.1",
    "shiki": "^4.1.0",
    "svelte": "^5.29.0",
    "svelte-check": "^4.1.6",
    "svelte2tsx": "^0.7.36",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.8",
    "vitest-browser-svelte": "^2.1.1"
  },
  "type": "module",
  "dependencies": {
    "@floating-ui/dom": "^1.7.0",
    "@layerstack/svelte-attachments": "workspace:*",
    "@layerstack/svelte-state": "workspace:*",
    "@layerstack/svelte-table": "workspace:*",
    "@layerstack/tailwind": "workspace:*",
    "@layerstack/utils": "workspace:*",
    "@lucide/svelte": "^0.577.0",
    "d3-array": "^3.2.4",
    "d3-scale": "^4.0.2",
    "esm-env": "^1.2.2",
    "immer": "^10.1.3",
    "lodash-es": "^4.17.23"
  },
  "peerDependencies": {
    "@shikijs/transformers": "^4.0.0",
    "shiki": "^4.0.0",
    "svelte": "^5.29.0"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    },
    "./utils/*": {
      "types": "./dist/utils/*.d.ts",
      "svelte": "./dist/utils/*.js"
    },
    "./*.css": "./dist/css/*.css"
  },
  "files": [
    "dist"
  ],
  "svelte": "./dist/index.js",
  "peerDependenciesMeta": {
    "shiki": {
      "optional": true
    },
    "@shikijs/transformers": {
      "optional": true
    }
  }
}

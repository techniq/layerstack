{
  "name": "@layerstack/docs-site",
  "description": "Documentation site for LayerStack",
  "author": "Sean Lynch <techniq35@gmail.com>",
  "license": "MIT",
  "private": true,
  "repository": "techniq/layerstack",
  "version": "1.1.0-next.8",
  "scripts": {
    "dev": "vite dev --port 3004",
    "prebuild": "pnpm generate:api",
    "build": "vite build",
    "preview": "vite preview",
    "package": "svelte-package",
    "prepublishOnly": "svelte-package",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "generate:api": "layerstack-docs generate-api ../packages/ui/src/lib/components generated/api",
    "generate:catalog": "layerstack-docs generate-catalog ../packages/ui/src/lib/components src/examples/components src/examples/catalog",
    "generate:screenshots": "layerstack-docs generate-screenshots src/examples/components static/screenshots",
    "generate:releases": "layerstack-docs generate-releases techniq/layerstack generated/releases",
    "generate:all": "pnpm generate:api && pnpm generate:screenshots && pnpm generate:catalog && pnpm generate:releases"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.4",
    "@content-collections/core": "^0.14.3",
    "@content-collections/markdown": "^0.1.4",
    "@content-collections/vite": "^0.2.9",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@iconify-json/lucide": "^1.2.53",
    "@iconify-json/simple-icons": "^1.2.84",
    "@sveltejs/adapter-cloudflare": "^7.0.3",
    "@sveltejs/kit": "^2.21.0",
    "@sveltejs/package": "^2.3.11",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.1.5",
    "@types/d3-array": "^3.2.1",
    "mdsx": "^0.0.7",
    "posthog-js": "^1.239.0",
    "prettier": "^3.5.3",
    "prettier-plugin-svelte": "^3.5.2",
    "rehype-slug": "^6.0.0",
    "svelte": "^5.29.0",
    "svelte-check": "^4.1.6",
    "svelte-ux": "2.0.0-next.22",
    "svelte2tsx": "^0.7.36",
    "tailwindcss": "^4.1.5",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3",
    "unist-util-visit": "^5.0.0",
    "unplugin-icons": "^22.1.0",
    "vite": "^6.3.5"
  },
  "type": "module",
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fortawesome/fontawesome-common-types": "^6.7.2",
    "@layerstack/docs": "workspace:*",
    "@layerstack/svelte-actions": "workspace:*",
    "@layerstack/svelte-attachments": "workspace:*",
    "@layerstack/svelte-state": "workspace:*",
    "@layerstack/svelte-stores": "workspace:*",
    "@layerstack/svelte-table": "workspace:*",
    "@layerstack/tailwind": "workspace:*",
    "@layerstack/ui": "workspace:*",
    "@layerstack/utils": "workspace:*",
    "@mdi/js": "^7.4.47",
    "clsx": "^2.1.1",
    "d3-array": "^3.2.4",
    "tailwind-merge": "^3.2.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "svelte": "^3.56.0 || ^4.0.0 || ^5.0.0-next.120"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "svelte": "./dist/index.js"
}
